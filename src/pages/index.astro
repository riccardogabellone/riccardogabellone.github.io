---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StatTiles from '../components/StatTiles.astro';
import LanguageBars from '../components/LanguageBars.astro';
import ContribCalendar from '../components/ContribCalendar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import SkillChips from '../components/SkillChips.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.status !== 'hidden')
  .sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.status === 'featured');
const listed = projects.filter((p) => p.data.status === 'listed');

const navItems = [
  ['#about', 'about'],
  ['#stats', 'stats'],
  ['#projects', 'projects'],
  ['#experience', 'experience'],
  ['#skills', 'skills'],
  ['#contact', 'contact'],
];
---
<Base title={`${site.name} - Software Engineer`} description={site.tagline}>
  <!-- Edge refraction for the bar. scripts/nav.ts paints the displacement map
       and switches it on where the browser can refract a backdrop. -->
  <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="nav-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feImage id="nav-lens-map" x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map"></feImage>
      <feDisplacementMap in="SourceGraphic" in2="map" scale="40" xChannelSelector="R" yChannelSelector="G"
      ></feDisplacementMap>
    </filter>
  </svg>

  <nav class="topnav container" aria-label="Sections">
    <div class="bar">
      <span class="glass bar-glass" aria-hidden="true"></span>
      <a class="mark mono" href="#top" aria-label="Back to top">rg<span class="cursor" aria-hidden="true">_</span></a>
      <ul class="links mono">
        {
          navItems.map(([href, label]) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
      <details class="menu">
        <summary aria-label="Menu">
          <span class="when-closed"><Icon name="menu" size={20} /></span>
          <span class="when-open"><Icon name="x" size={20} /></span>
        </summary>
        <div class="sheet">
          <span class="glass sheet-glass" aria-hidden="true"></span>
          <ul class="mono">
            {
              navItems.map(([href, label]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>

  <Hero />
  <div class="container">
    <hr class="lightbar" />
  </div>

  <main class="container">
    <section id="about" class="section about">
      <h2 class="section-title">About</h2>
      <p class="prose">{site.about}</p>
    </section>

    {
      site.stats_section.show && (
        <section id="stats" class="section">
          <details class="fold" id="stats-fold">
            <summary>
              <h2 class="section-title">GitHub Statistics</h2>
              <span class="fold-hint mono" aria-hidden="true">
                <span class="word when-closed">show</span>
                <span class="word when-open">hide</span>
                <Icon name="chevron-down" size={16} />
              </span>
            </summary>
            <div class="fold-body">
              <StatTiles />
              <ContribCalendar />
              <h3 class="subhead">Language breakdown <span class="mono note">(latest 1k commits)</span></h3>
              <LanguageBars />
            </div>
          </details>
        </section>
      )
    }

    <section id="projects" class="section">
      <h2 class="section-title">Featured Projects</h2>
      <div class="proj-grid featured">
        {featured.map((p, i) => <ProjectCard project={p} flagship={i === 0} />)}
      </div>
      {
        listed.length > 0 && (
          <div class="proj-grid listed">
            {listed.map((p) => (
              <ProjectCard project={p} />
            ))}
          </div>
        )
      }
    </section>

    <section id="experience" class="section">
      <h2 class="section-title">Experience &amp; Education</h2>
      <Timeline />
    </section>

    <section id="skills" class="section">
      <h2 class="section-title alt">Skills &amp; Tech Stack</h2>
      <SkillChips />
    </section>

    <Contact />
  </main>

  <Footer />
  <script src="../scripts/nav.ts"></script>
  {site.stats_section.show && <script src="../scripts/revalidate.ts"></script>}
</Base>

<style>
  /* Floating glass bar. `.topnav` is a `.container`, so the bar's edges sit on
     the same margins as the content below it. The glass is a layer behind the
     bar's content (see `.glass` in global.css). */
  .lens-defs {
    position: absolute;
  }
  .topnav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    padding: 0 0.4rem 0 1.4rem;
    border-radius: 999px;
  }
  .bar-glass,
  .sheet-glass {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
  }
  /* Refraction bends what is behind the rim, so the blur drops to let it read.
     Blur first, lens second: the lens clips its output to the bar, and a blur
     after it would fade that edge to transparent and let sharp page text
     through along the rim. */
  @supports (backdrop-filter: blur(1px)) {
    .bar-glass.lens {
      backdrop-filter: blur(7px) url(#nav-lens) saturate(1.8) brightness(1.08);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .bar-glass.lens {
      backdrop-filter: none;
    }
  }
  .mark {
    color: var(--gold);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
  }
  .mark .cursor {
    animation: blink 1.2s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
  .links,
  .sheet ul {
    list-style: none;
    margin: 0;
  }
  .links {
    display: flex;
    gap: 0.15rem;
    padding: 0;
    font-size: 0.82rem;
  }
  .links a {
    display: block;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--body-text);
    text-decoration: none;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.55);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .links a:hover {
    color: var(--gold);
    background-color: rgb(255 255 255 / 0.08);
  }

  /* Phones: the six links move into a sheet that drops from the bar. */
  .menu {
    display: none;
  }
  .menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--text);
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: grid;
  }
  .menu[open] summary {
    color: var(--gold);
    background-color: rgb(255 255 255 / 0.08);
  }
  .menu[open] .when-closed,
  .menu:not([open]) .when-open {
    display: none;
  }
  .sheet {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 1;
    border-radius: 1.4rem;
  }
  .sheet ul {
    display: grid;
    gap: 2px;
    padding: 0.5rem;
    font-size: 0.95rem;
  }
  .sheet a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 0.9rem;
    color: var(--text);
    text-decoration: none;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.55);
  }
  .sheet a::before {
    content: '//';
    margin-right: 0.7ch;
    color: var(--gold);
    font-weight: 700;
  }
  .sheet a:hover,
  .sheet a:active {
    color: var(--gold);
    background-color: rgb(255 255 255 / 0.08);
  }
  /* The sheet holds more text over more page, so it frosts harder than the bar. */
  @supports (backdrop-filter: blur(1px)) {
    .sheet-glass {
      --glass-tint: 62%;
      backdrop-filter: blur(22px) saturate(1.8) brightness(1.05);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .sheet-glass {
      --glass-tint: 100%;
      backdrop-filter: none;
    }
  }
  @media (max-width: 760px) {
    .bar {
      padding: 0 0.25rem 0 1.25rem;
    }
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }
  /* Only transform and the list fade: fading the sheet itself would isolate
     its glass from the page for the length of the animation. */
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .sheet {
      transform-origin: top right;
      animation: sheet-in 220ms cubic-bezier(0.2, 0.7, 0.3, 1);
    }
    .menu[open] .sheet ul {
      animation: sheet-fade 220ms ease;
    }
    @keyframes sheet-in {
      from {
        transform: translateY(-0.4rem) scale(0.97);
      }
    }
    @keyframes sheet-fade {
      from {
        opacity: 0;
      }
    }
  }

  .section {
    margin-top: 4.5rem;
  }
  .section:first-child {
    margin-top: 3rem;
  }
  @media (max-width: 600px) {
    .section {
      margin-top: 3.5rem;
    }
    .section:first-child {
      margin-top: 2.5rem;
    }
  }
  .about .prose {
    margin: 0;
    font-size: 1.05rem;
    border-left: 2px solid var(--gold-deep);
    padding-left: 1.25rem;
    text-wrap: pretty;
  }

  /* GitHub statistics fold: closed by default, fades and unrolls when toggled.
     Browsers without ::details-content toggle it instantly. */
  .fold summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary .section-title {
    margin: 0;
  }
  .fold-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }
  .fold summary:hover .fold-hint {
    color: var(--gold);
    border-color: var(--gold-deep);
  }
  .fold[open] .when-closed,
  .fold:not([open]) .when-open {
    display: none;
  }
  .fold-hint :global(svg) {
    transition: transform 300ms ease;
  }
  .fold[open] .fold-hint :global(svg) {
    transform: rotate(180deg);
  }
  @media (max-width: 420px) {
    .fold-hint {
      padding: 0.4rem;
    }
    .fold-hint .word {
      display: none;
    }
  }
  .fold-body {
    padding-top: 1.25rem;
  }
  .fold::details-content {
    opacity: 0;
  }
  .fold[open]::details-content {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fold::details-content {
      transition-property: opacity, content-visibility;
      transition-duration: 380ms;
      transition-timing-function: ease;
      transition-behavior: allow-discrete;
    }
    /* Where the browser can animate to an intrinsic height, unroll as well. */
    @supports (interpolate-size: allow-keywords) {
      .fold {
        interpolate-size: allow-keywords;
      }
      .fold::details-content {
        block-size: 0;
        overflow-y: clip;
        transition-property: opacity, block-size, content-visibility;
        transition-duration: 380ms, 460ms, 460ms;
        transition-timing-function: ease, cubic-bezier(0.2, 0.7, 0.3, 1), ease;
      }
      .fold[open]::details-content {
        block-size: auto;
      }
    }
  }
  .subhead {
    font-size: 1.05rem;
    color: var(--text);
    margin: 2.25rem 0 1rem;
  }
  .subhead .note {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .proj-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  /* Featured: flagship spans the row, the other two split it — no empty track */
  .proj-grid.featured {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) {
    .proj-grid.featured {
      grid-template-columns: 1fr;
    }
  }
  .proj-grid.featured > :global(.flagship) {
    grid-column: 1 / -1;
  }
  .proj-grid.listed {
    margin-top: 1rem;
  }
</style>

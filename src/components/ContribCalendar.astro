---
import { getStats } from '../lib/stats';
import { buildYearGrid, RAMP } from '../lib/contrib';

const { contributionData } = getStats();
const years = [...contributionData.years].sort((a, b) => Number(b.year) - Number(a.year));
const totalContributions = years.reduce((sum, y) => sum + y.total, 0);
const latestYear = years[0]?.year ?? String(new Date().getFullYear());
const latestTotal = years[0]?.total ?? 0;
const grid = buildYearGrid(latestYear, contributionData.contributions);
---
<div class="calendar" data-latest-year={latestYear}>
  <div
    id="contrib-viewport"
    class="viewport"
    role="img"
    aria-label={`GitHub contribution calendar, ${latestTotal.toLocaleString('en-US')} contributions in ${latestYear}`}
  >
    <div id="contrib-transform" class="transform-wrapper">
      <div id="contrib-grid" class="grid">
        {Array.from({ length: grid.leadingBlanks }).map(() => <div class="cell blank"></div>)}
        {
          grid.cells.map((c) => (
            <div
              class="cell"
              style={`background:${RAMP[c.intensity]}`}
              title={c.count > 0 ? `${c.date}: ${c.count} contribution${c.count === 1 ? '' : 's'}` : c.date}
            ></div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="legend mono" aria-hidden="true">
    <span>less</span>
    {RAMP.map((color) => <span class="cell" style={`background:${color}`}></span>)}
    <span>more</span>
  </div>
  <div id="contrib-years" class="years" role="group" aria-label="Select contribution year">
    <span class="chip total mono">Total: {totalContributions.toLocaleString('en-US')}</span>
    {
      years.map((y) => (
        <button
          type="button"
          class:list={['chip', 'mono', 'year-chip', { selected: y.year === latestYear }]}
          data-year={y.year}
          aria-pressed={y.year === latestYear ? 'true' : 'false'}
        >
          {y.year}: {y.total.toLocaleString('en-US')}
        </button>
      ))
    }
  </div>
</div>

<script type="application/json" id="contrib-data" set:html={JSON.stringify(contributionData)}></script>
<script src="../scripts/calendar.ts"></script>

<style>
  .calendar {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin-top: 2.25rem;
  }
  .viewport {
    height: 118px;
    overflow: hidden;
    position: relative;
    touch-action: none;
    cursor: grab;
  }
  .viewport.grabbing {
    cursor: grabbing;
  }
  .transform-wrapper {
    width: max-content;
    height: max-content;
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .grid {
    display: grid;
    grid-template-rows: repeat(7, 12px);
    grid-auto-flow: column;
    grid-auto-columns: 12px;
    gap: 3px;
    width: max-content;
  }
  .cell {
    width: 12px;
    height: 12px;
    border-radius: 2px;
    background: #1a2430;
  }
  .cell.blank {
    visibility: hidden;
  }
  .grid .cell:hover {
    outline: 1px solid var(--text);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
    margin-top: 0.6rem;
    font-size: 0.68rem;
    color: var(--muted);
  }
  .years {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .years .chip {
    font-size: 0.72rem;
  }
  .chip.total {
    background: var(--panel-2);
    border-color: var(--line);
    color: var(--text);
  }
  .year-chip {
    cursor: pointer;
    background: transparent;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .year-chip:hover {
    border-color: var(--gold-deep);
    color: var(--gold);
  }
  .year-chip.selected {
    background: var(--gold);
    border-color: var(--gold);
    color: #16202c;
    cursor: default;
    font-weight: 700;
  }
</style>
